# CogniPilot Back — env vars
# Copiar a .env y completar. .env NO se commitea.

# ──────────────────────────────────────────────────────────────────────────────
# Postgres
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=cognipilot
POSTGRES_PASSWORD=cambiar-en-vm
POSTGRES_DB=cognipilot

# ─── MODO PARALELO (default) ─────────────────────────────────────────────────
# El back-api conecta al postgres que ya corre en cognipilot-remote.
# host.docker.internal apunta al host (la VM), donde postgres está expuesto en :5432.
DATABASE_URL=postgresql+asyncpg://cognipilot:cambiar-en-vm@host.docker.internal:5432/cognipilot
DATABASE_URL_SYNC=postgresql://cognipilot:cambiar-en-vm@host.docker.internal:5432/cognipilot

# ─── MODO BUNDLED (post-cutover) ─────────────────────────────────────────────
# Comentar las dos de arriba y descomentar estas. Activar con: docker compose --profile bundled-db up
# DATABASE_URL=postgresql+asyncpg://cognipilot:cambiar-en-vm@pgbouncer:5432/cognipilot
# DATABASE_URL_SYNC=postgresql://cognipilot:cambiar-en-vm@postgres:5432/cognipilot

# Puerto externo del back-api (validación previa al cutover). Default 8001.
BACK_API_PORT=8001

# ──────────────────────────────────────────────────────────────────────────────
# Redis (cache + arq queue backend)
# ──────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ──────────────────────────────────────────────────────────────────────────────
# JWT — MISMOS secrets que el back Next.js para compatibilidad de tokens
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar-32-bytes-hex
JWT_REFRESH_SECRET=cambiar-32-bytes-hex-distinto
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ──────────────────────────────────────────────────────────────────────────────
# Cookies (mismas que Next: cp_at / cp_rt)
# ──────────────────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ──────────────────────────────────────────────────────────────────────────────
# Firebase Admin (FCM push) — JSON completo del service account en una línea
# ──────────────────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ──────────────────────────────────────────────────────────────────────────────
# CORS — si el front corre en otro origen durante dev
# ──────────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Observabilidad
# ──────────────────────────────────────────────────────────────────────────────
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_ADMIN_PASSWORD=cambiar-en-vm

# ──────────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────────
APP_NAME=cognipilot-back
APP_ENV=production
LOG_LEVEL=INFO
