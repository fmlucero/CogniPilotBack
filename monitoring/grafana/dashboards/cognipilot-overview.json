          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Latencia (p50 / p95 / p99)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
